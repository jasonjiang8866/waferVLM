# Reuse the exact already-tested CUDA/Transformers/PEFT environment; do not resolve new dependencies.
FROM ghcr.io/jasonjiang8866/wafervlm@sha256:b13a9807ae05698f0813e0d1ab7f25548e782f65729d2b2aec5e66de6de24cd1
ARG SOURCE_SHA
ENV WAFERVLM_SOURCE_SHA=${SOURCE_SHA}
WORKDIR /app
COPY src ./src
COPY configs ./configs
COPY scripts ./scripts
COPY tests ./tests
RUN python -m unittest discover -s tests -p 'test_confirmation*.py' -v
ENTRYPOINT ["python", "scripts/run_seed_confirmation.py"]
